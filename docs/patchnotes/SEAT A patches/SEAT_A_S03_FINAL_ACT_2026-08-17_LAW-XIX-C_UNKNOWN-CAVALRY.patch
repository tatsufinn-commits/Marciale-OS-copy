+import { ScreenManager } from '../src/ui/ScreenManager.js';
+
+function makeManager() {
+  const sm = new ScreenManager();
+  sm.register('quests', { render: () => '<ul><li>Rift Purge</li></ul>' });
+  sm.register('roster', { render: () => '<ul><li>Rudeus</li></ul>' });
